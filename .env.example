# ─────────────────────────────────────────────────────────────
# Base de datos (Neon Postgres). Usa la connection string POOLED
# (la que trae `-pooler` en el host) para funciones serverless.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/tienda?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Métodos de pago. Se activan y se elige el modo (prueba/producción) en
# /admin/pagos; aquí solo van las llaves de cada modo.
# ─────────────────────────────────────────────────────────────
# Mercado Pago (Tus integraciones → Credenciales). La URL de avisos se manda
# en cada cobro, no hay que registrarla. El secreto del webhook es opcional.
MERCADOPAGO_ACCESS_TOKEN_TEST="TEST-xxx"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxx"
MERCADOPAGO_WEBHOOK_SECRET_TEST=""
MERCADOPAGO_WEBHOOK_SECRET=""

# PayPal (developer.paypal.com → Apps & Credentials). Registra el webhook que
# muestra /admin/pagos; su Webhook ID es opcional pero recomendado.
PAYPAL_CLIENT_ID_SANDBOX="xxx"
PAYPAL_CLIENT_SECRET_SANDBOX="xxx"
PAYPAL_WEBHOOK_ID_SANDBOX=""
PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"
PAYPAL_WEBHOOK_ID=""

# TEMPORAL: "true" simula compras exitosas sin pasarela (para probar el flujo
# completo). Tiene prioridad sobre los métodos de /admin/pagos.
SIMULATE_PAYMENTS="false"

# ─────────────────────────────────────────────────────────────
# Correos (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
# Webhook de Resend (Webhooks → Add endpoint → <tienda>/api/webhooks/resend, eventos email.*).
# Su "Signing secret" (whsec_...). Para ver aperturas y clics activa el tracking en el dominio.
RESEND_WEBHOOK_SECRET=""
# Remitente. Pruebas: "Tienda Nume <onboarding@resend.dev>" (solo entrega al
# correo de tu cuenta Resend). Producción: un remitente de tu DOMINIO VERIFICADO
# en Resend, p. ej. "Tienda Nume <pedidos@numerologia-cotidiana.com>".
EMAIL_FROM="Tienda Nume <onboarding@resend.dev>"
# Opcional: a dónde llegan las respuestas de los clientes.
EMAIL_REPLY_TO=""
# Opcional: aviso interno con el resumen de cada compra pagada. Uno o varios
# correos separados por coma. Vacío = no se envía. Responder ese aviso le
# escribe directo al cliente.
ORDER_NOTIFY_EMAIL=""

# ─────────────────────────────────────────────────────────────
# Generador de reportes (Railway). Sin estas dos, los reportes se
# marcan "skipped" y el resto de la compra funciona normal.
# ─────────────────────────────────────────────────────────────
REPORT_GENERATOR_URL="https://<tu-servicio>.up.railway.app"
REPORT_WEBHOOK_SECRET="<el mismo WEBHOOK_SECRET de Railway>"
# Protege el cron /api/cron/reports (Vercel Cron manda este Bearer).
CRON_SECRET="un-secreto-largo-y-aleatorio"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# En producción: https://tienda.numerologia-cotidiana.com
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_STORE_NAME="Tienda Nume"

# Analytics (ver docs/analytics.md). Sin el ID, ese servicio no se carga.
# Se leen al compilar: tras cambiarlas en Vercel hay que redesplegar.
# Google Analytics 4 (G-XXXXXXXXXX).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Pixel (Administrador de eventos → Orígenes de datos → ID del pixel).
NEXT_PUBLIC_META_PIXEL_ID=

# Impuesto fijo aplicado al subtotal (0.16 = 16%). 0 = sin impuesto.
DEFAULT_TAX_RATE="0.16"
# Moneda por defecto (ISO 4217).
# La tienda opera solo en pesos mexicanos (Mercado Pago México cobra en MXN).
DEFAULT_CURRENCY="MXN"

# Secreto para firmar los tokens de descarga de productos digitales.
DOWNLOAD_TOKEN_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ─────────────────────────────────────────────────────────────
# Panel admin. Se entra con una cuenta de la API de nume que tenga role
# "admin" (ver NUME_API_BASE_URL abajo) y luego con el código de una app
# autenticadora (verificación en dos pasos de la tienda).
# ─────────────────────────────────────────────────────────────
# Opcional. Ruta secreta del panel: minúsculas, números y guiones, 3 a 63
# caracteres (p. ej. "gestion-x7k2"). Vacía = /admin. Con valor, el panel vive
# en /<ADMIN_PATH> y /admin responde 404. Cambiarla requiere volver a desplegar.
ADMIN_PATH=""
# OBLIGATORIA en Vercel (producción y preview). Firma la verificación en dos
# pasos y cifra los secretos de las apps autenticadoras. Sin ella nadie entra al
# panel. Si cambia, todos los admins deben volver a configurar su app.
# Generar con: openssl rand -hex 32
ADMIN_2FA_SECRET=""

# ── Cuentas de cliente (API de nume) ─────────────────────────────
# La tienda delega el login a la API NestJS de nume; no guarda contraseñas.
NUME_API_BASE_URL="https://api-nume-production.up.railway.app/api/v1"

# Opcional. Secreto compartido para reenviar a la API de nume la IP real del
# visitante (cabeceras X-Nume-Client-IP / X-Nume-Proxy-Key) en login y refresh,
# así su rate limit es por cliente y no por el servidor de la tienda.
# Debe ser EXACTAMENTE el mismo valor en la API, en WEB NUME y aquí.
# Generar con: openssl rand -hex 32. Solo servidor: nunca con prefijo NEXT_PUBLIC_.
INTERNAL_PROXY_SECRET=
# Sitio público de nume (gestión de cuenta, registro, reset de contraseña).
NEXT_PUBLIC_NUME_SITE_URL="https://web-nume.vercel.app"

# ── Imágenes y archivos (Cloudflare R2) ──────────────────────────
# R2 → Manage API tokens: token con "Object Read & Write" sobre el bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="numerologia"
# Carpeta de la tienda dentro del bucket (queda tienda/images y tienda/files).
R2_PREFIX="tienda"
# URL pública del bucket, sin "/" final: dominio propio conectado al bucket
# (p. ej. https://media.numerologia-cotidiana.com) o su https://pub-xxx.r2.dev.
# El bucket necesita CORS que permita PUT desde la tienda para subir desde el admin.
R2_PUBLIC_URL=""
